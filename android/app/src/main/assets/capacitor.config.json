{
	"appId": "com.nico.ai",
	"appName": "Nico AI",
	"webDir": ".output/public",
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1200,
			"backgroundColor": "#070B18",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false
		},
		"LocalNotifications": {
			"smallIcon": "ic_stat_nico",
			"iconColor": "#4F6BFF"
		}
	}
}
